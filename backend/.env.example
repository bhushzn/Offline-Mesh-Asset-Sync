# ─── Server ───────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ─── Database ─────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tacsync?schema=public"

# ─── Authentication ───────────────────────────────
JWT_SECRET="CHANGE_ME_to_a_random_64_char_string"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_SECRET="CHANGE_ME_to_another_random_64_char_string"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Security ─────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── CORS ─────────────────────────────────────────
CORS_ORIGIN="http://localhost:5173"

# ─── Logging ──────────────────────────────────────
LOG_LEVEL="info"
